limit_req_zone $binary_remote_addr zone=public_ai:10m rate=6r/m;
server {
    listen 8080;
    server_name _;
    client_max_body_size 12m;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location ~ ^/api/(detect|chat)$ {
        limit_req zone=public_ai burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Inspection-Admin "";
    }
    location / {
        proxy_pass http://app:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Inspection-Admin "";
    }
}
server {
    listen 8081;
    server_name _;
    client_max_body_size 12m;
    proxy_read_timeout 180s;
    location / {
        proxy_pass http://app:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Inspection-Admin "${INSPECTION_ADMIN_TOKEN}";
    }
}
